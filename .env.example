# ===== Lark 开放平台应用凭证 =====
LARK_APP_ID=cli_xxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxx
# Webhook 安全校验用（Lark 后台"事件订阅"页生成，生产环境必填！）
LARK_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxx
# 若开启了加密，填 Encrypt Key（可选）
ENCRYPT_KEY=

# ===== 服务端口 =====
PORT=8766

# ===== MiniMax（LLM/ASR/VLM/TTS）=====
MINIMAX_API_KEY=xxxxxxxxxxxxxxxx
